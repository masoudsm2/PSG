proxy-groups:
  - name: 🚀 Proxy
    type: select
    proxies:
      - ♻️ Auto
      - 🎯 Direct

  - name: ♻️ Auto
    type: url-test
    url: http://www.gstatic.com/generate_204
    interval: 300
    proxies: 
      - '🇨🇦 CA | 🔴 | vless | @NamiraConfigs | 66'
      - '🇨🇦 CA | 🔴 | vless | @NamiraConfigs | 67'
      - '🇨🇦 CA | 🔴 | vless | @NamiraConfigs | 68'
      - '🇩🇪 DE | 🔴 | vless | @NamiraConfigs | 69'

  - name: 🌍 Global Media
    type: select
    proxies:
      - 🚀 Proxy
      - ♻️ Auto
      - 🎯 Direct

  - name: 🎯 Direct
    type: select
    proxies:
      - DIRECT

  - name: 🛑 Ad Block
    type: select
    proxies:
      - REJECT
      - DIRECT

  - name: 🐟 Fallback
    type: select
    proxies:
      - 🚀 Proxy
      - 🎯 Direct

